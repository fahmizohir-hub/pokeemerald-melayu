MagmaHideout_2F_2R_Text_Grunt15Intro:
	.string "Aku tak ada masalah dengan kau.\n"
	.string "Aku cuma ikut arahan!$"

MagmaHideout_2F_2R_Text_Grunt15Defeat:
	.string "Aku mungkin kalah, tapi…$"

MagmaHideout_2F_2R_Text_Grunt15PostBattle:
	.string "Kami gali sesuatu yang tak dapat\n"
	.string "dipercayai! Dan kami dapat MESTIKA\l"
	.string "BIRU!\p"
	.string "Sekarang cuma tinggal ketua kami…\n"
	.string "Fufufu… Fwahahaha!$"

MagmaHideout_2F_2R_Text_Grunt6Intro:
	.string "Aku tak tahan panas. Mungkin aku patut\n"
	.string "sertai TEAM AQUA saja…$"

MagmaHideout_2F_2R_Text_Grunt6Defeat:
	.string "Yalah, mungkin aku memang tak sesuai\n"
	.string "dengan TEAM MAGMA…$"

MagmaHideout_2F_2R_Text_Grunt6PostBattle:
	.string "Kau tak rindu laut ke bila berada\n"
	.string "di tempat macam ni?$"

MagmaHideout_2F_2R_Text_Grunt7Intro:
	.string "Kadang-kadang ada gegaran di sini.\p"
	.string "Gunung berapi bergoncang ke?\n"
	.string "Atau GROU…\p"
	.string "Alamak!\n"
	.string "Tak, tak, lupakan!$"

MagmaHideout_2F_2R_Text_Grunt7Defeat:
	.string "Kau memang petarung yang berapi.\n"
	.string "Macam gunung berapi!$"

MagmaHideout_2F_2R_Text_Grunt7PostBattle:
	.string "Kau cuma kebetulan menang kali ni,\n"
	.string "tapi itu tak penting.\p"
	.string "Matlamat TEAM MAGMA hampir\n"
	.string "tercapai!$"

MagmaHideout_2F_2R_Text_Grunt8Intro:
	.string "Salah seorang kawan kami panik sebab\n"
	.string "LAMBANG MAGMA dia hilang…\p"
	.string "Tunggu sekejap!\n"
	.string "Kau ke yang jumpa benda tu?$"

MagmaHideout_2F_2R_Text_Grunt8Defeat:
	.string "Aku susah nak percaya ni…$"

MagmaHideout_2F_2R_Text_Grunt8PostBattle:
	.string "Aku rasa macam rancangan kami akan\n"
	.string "berakhir dengan kegagalan…$"

