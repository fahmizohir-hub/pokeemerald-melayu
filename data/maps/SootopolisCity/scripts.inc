	copyobjectxytoperm LOCALID_SOOTOPOLIS_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 2
	return

SootopolisCity_EventScript_GoToSkyPillar::
	msgbox SootopolisCity_Text_HaventYouScaledSkyPillar, MSGBOX_DEFAULT
	release
	end

SootopolisCity_EventScript_GoToGym::
	msgbox SootopolisCity_Text_DazzledByMentor, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Movement_WallaceMoveFromGym:
	walk_right
	walk_in_place_faster_down
	step_end

SootopolisCity_Movement_WallaceMoveFromGymWest:
	walk_left
	walk_in_place_faster_down
	step_end

SootopolisCity_EventScript_Maxie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_MaxieRayquaza
	msgbox SootopolisCity_Text_GroudonPleaseStop, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_MaxieRayquaza::
	msgbox SootopolisCity_Text_AfterAllOurScheming, MSGBOX_DEFAULT
	setflag FLAG_MET_MAXIE_SOOTOPOLIS
	goto_if_set FLAG_MET_ARCHIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_Archie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_ArchieRayquaza
	msgbox SootopolisCity_Text_KyogreCalmDown, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_ArchieRayquaza::
	msgbox SootopolisCity_Text_TryingMeaninglessToPokemon, MSGBOX_DEFAULT
	setflag FLAG_MET_ARCHIE_SOOTOPOLIS
	goto_if_set FLAG_MET_MAXIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_MaxieArchieLeave::
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE
	setflag FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_MAXIE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE
	setvar VAR_MT_PYRE_STATE, 2
	warpsilent MAP_SOOTOPOLIS_CITY, 31, 34
	waitstate
	releaseall
	end

@ Unused
SootopolisCity_Movement_Levitate::
	levitate
	step_end

@ Unused
SootopolisCity_Movement_DestroyTask::
	destroy_extra_task
	step_end

SootopolisCity_Text_GymSign:
	.string "GIM POKéMON BANDAR SOOTOPOLIS\n"
	.string "KETUA: JUAN\p"
	.string "“KETUA GIM dengan keindahan\n"
	.string "air yang jernih!”$"

SootopolisCity_Text_CitySign:
	.string "BANDAR SOOTOPOLIS\p"
	.string "“Bandar mistik tempat sejarah\n"
	.string "terlena.”$"

SootopolisCity_Text_DoorIsClosed:
	.string "Pintu ini tertutup.$"

SootopolisCity_Text_PhysicallyFitLivingHere:
	.string "Menyelam di laut. Naik turun tangga\n"
	.string "sepanjang masa…\p"
	.string "Kalau tinggal di bandar ni, badan kamu\n"
	.string "mesti jadi cergas.$"

SootopolisCity_Text_GiantPokemonSuddenlyAppeared:
	.string "POKéMON gergasi ni tiba-tiba muncul di\n"
	.string "tengah-tengah bandar!\p"
	.string "Saya tak pernah nampak mereka sebelum\n"
	.string "ni!\p"
	.string "Kenapa mereka berlanggar sesama\n"
	.string "sendiri macam tu?\p"
	.string "Kenapa POKéMON tu tak boleh berkawan?$"

SootopolisCity_Text_WhatIsThatGreenPokemon:
	.string "Apa? Apa? Apa?\n"
	.string "POKéMON hijau apa tu?!$"

SootopolisCity_Text_WhereDidLegendariesGo:
	.string "GROUDON dan KYOGRE…\n"
	.string "Ke mana mereka pergi?\p"
	.string "Mereka akan sebabkan kemarau atau\n"
	.string "hujan lebat di tempat lain pula ke?$"

SootopolisCity_Text_TwoPokemonArentAngry:
	.string "Entah kenapa saya rasa kedua-dua\n"
	.string "POKéMON tu bukannya marah.\p"
	.string "Saya rasa… Mereka mungkin tak dapat\n"
	.string "kawal kuasa sendiri…$"

SootopolisCity_Text_FlyingMonStoppedRampage:
	.string "POKéMON terbang tu turun dari langit\n"
	.string "dan hentikan POKéMON yang sedang\l"
	.string "mengamuk…$"

SootopolisCity_Text_WonderWhatWorldIsLike:
	.string "Saya… Saya tak pernah keluar dari\n"
	.string "bandar ni.\p"
	.string "Macam mana agaknya dunia di sebalik\n"
	.string "langit bulat ni?$"

SootopolisCity_Text_ThisIsWicked:
	.string "Wah!\n"
	.string "Hebat gila!$"

SootopolisCity_Text_ThatWasWicked:
	.string "Wah!\n"
	.string "Tadi tu hebat gila!$"

SootopolisCity_Text_GoRedAndBlueMon:
	.string "Ayuh, POKéMON merah!\n"
	.string "Jangan undur, POKéMON biru!$"

SootopolisCity_Text_DoYouKnowMonNames:
	.string "… … … … … …\p"
	.string "Hai, kamu tahu nama POKéMON yang\n"
	.string "sedang bergaduh di sana tu?$"

SootopolisCity_Text_GreenOneSettlesThings:
	.string "Saya tertanya-tanya siapa menang,\n"
	.string "yang merah atau yang biru, tapi alamak,\l"
	.string "yang hijau pula yang selesaikannya!\p"
	.string "Tak sangka langsung jadi macam tu!$"

SootopolisCity_Text_SeeingLegendWithOwnEyes:
	.string "Ada legenda purba yang kata\n"
	.string "darat dan laut terbentuk akibat\l"
	.string "pertarungan hebat antara POKéMON.\p"
	.string "Sekarang saya nampak sendiri\n"
	.string "dengan mata kepala saya!\p"
	.string "Wah! Tak sangka saya dapat\n"
	.string "saksikan sesuatu sebesar ini!$"

SootopolisCity_Text_SawLegendWithOwnEyes:
	.string "Ada legenda purba yang kata\n"
	.string "darat dan laut terbentuk akibat\l"
	.string "pertarungan hebat antara POKéMON.\p"
	.string "Saya nampak sendiri\n"
	.string "dengan mata kepala saya!\p"
	.string "Wah! Tak sangka saya dapat\n"
	.string "saksikan sesuatu sebesar ini!$"

SootopolisCity_Text_BigPokemonFighting:
	.string "POKéMON besar sedang bergaduh dengan\n"
	.string "POKéMON besar yang lain!\p"
	.string "Tolonglah, sesiapa hentikan mereka!$"

SootopolisCity_Text_PrettyMonCameFromSky:
	.string "Ada POKéMON cantik turun dari langit…$"

SootopolisCity_Text_SootopolisWillBeWrecked:
	.string "Oh, tidak!\n"
	.string "BANDAR SOOTOPOLIS akan musnah!$"

SootopolisCity_Text_SootopolisDidntGetWrecked:
	.string "BANDAR SOOTOPOLIS tak musnah!$"

SootopolisCity_Text_NoOrdinaryTourist:
	.string "Hm!\n"
	.string "Kamu datang jauh-jauh ke SOOTOPOLIS?\l"
	.string "Kamu bukan pelancong biasa.\p"
	.string "Tapi itu tak bermakna kamu pelancong\n"
	.string "luar biasa juga.$"

SootopolisCity_Text_CityRegainedCalm:
	.string "Bandar ini dah kembali tenang…$"

SootopolisCity_Text_CaveOfOriginPleaseLeave:
	.string "Kamu siapa?\p"
	.string "Ini GUA ORIGIN.\p"
	.string "Kononnya roh POKéMON yang tenang di\n"
	.string "GUNUNG PYRE dihidupkan semula di sini.\p"
	.string "Sila pergi.$"

SootopolisCity_Text_LeadSuperiorTrainerToCave:
	.string "Seseorang yang berkemahuan kuat dan\n"
	.string "berbakat luar biasa…\p"
	.string "JURULATIH yang ada ilmu dan pengalaman\n"
	.string "dengan pelbagai jenis POKéMON…\p"
	.string "Kalau orang begitu muncul, WALLACE\n"
	.string "arahkan saya bawa JURULATIH itu\l"
	.string "ke GUA ini.$"

SootopolisCity_Text_AwakenedPokemonClash:
	.string "Oh, wah…\p"
	.string "Pertembungan dua POKéMON yang terjaga\n"
	.string "itu reda bila POKéMON ketiga bangkit…$"

SootopolisCity_Text_CaveOfOriginSleepsToo:
	.string "Ini GUA ORIGIN…\p"
	.string "Dengan berlalunya krisis, gua ini pun\n"
	.string "akan tidur semula…$"

SootopolisCity_Text_SootopolisSkyBeautiful:
	.string "SOOTOPOLIS asalnya bandar yang\n"
	.string "terbina dalam kawah gunung berapi.\p"
	.string "Kalau kamu dongak ke langit,\n"
	.string "bibir kawah pun nampak. Jadi,\l"
	.string "langit yang kamu nampak bulat.\p"
	.string "Tapi sebab itulah langit di\n"
	.string "atas SOOTOPOLIS paling cantik.$"

SootopolisCity_Text_GiganticPokemonFight:
	.string "Bila dua POKéMON sebesar tu\n"
	.string "bergaduh seganas itu, tak banyak\l"
	.string "yang kita boleh buat.$"

SootopolisCity_Text_FearedWorstWhenPokemonFlewDown:
	.string "Bila POKéMON ketiga tu terbang turun,\n"
	.string "saya ingatkan habislah semuanya.$"

SootopolisCity_Text_NightSkyFavoriteScenery:
	.string "Bulatan langit malam berbingkaikan\n"
	.string "kawah gunung berapi…\p"
	.string "Dan dalam bulatan itu, bintang\n"
	.string "berkelip-kelip seolah-olah hidup…\l"
	.string "Itulah pemandangan kegemaran saya.$"

SootopolisCity_Text_WeatherWentWild:
	.string "Cuaca cerah pagi tadi, tapi…\p"
	.string "Tiba-tiba awan gelap berkumpul,\n"
	.string "hujan turun mencurah-curah,\l"
	.string "ada guruh dan kilat sekali.\p"
	.string "Cuaca jadi tak tentu arah langsung!\p"
	.string "Semua ni sebab POKéMON tu ke?$"

SootopolisCity_Text_YouBroughtFlyingMon:
	.string "Oh?\p"
	.string "Kamu ke yang bawa POKéMON terbang tu\n"
	.string "ke sini?\p"
	.string "Wah, hebatnya kamu!$"

SootopolisCity_Text_GroudonPleaseStop:
	.string "MAXIE: G… GROUDON…\n"
	.string "Tolong! Hentikan perbuatan kau!\p"
	.string "Aku dah tahu sejauh mana kuasa kau!\p"
	.string "Kalau kau teruskan, seluruh HOENN,\n"
	.string "bukan saja SOOTOPOLIS, akan musnah!$"

SootopolisCity_Text_AfterAllOurScheming:
	.string "MAXIE: Jadi POKéMON teramat purba\n"
	.string "bukan cuma GROUDON dan KYOGRE…\p"
	.string "Selepas semua rancangan sia-sia dan\n"
	.string "usaha terdesak kami, tindakan mudah\l"
	.string "satu POKéMON itu memulihkan semuanya\l"
	.string "seolah-olah tiada apa yang berlaku…\p"
	.string "Fu…\n"
	.string "Fuhahaha…$"

SootopolisCity_Text_KyogreCalmDown:
	.string "ARCHIE: KYOGRE! Kenapa ni?!\n"
	.string "Tengok sini! Ini MESTIKA MERAH!\l"
	.string "Bertenang! KYOGRE!\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "Tak guna!\n"
	.string "Ia langsung tak bertindak balas!$"

SootopolisCity_Text_TryingMeaninglessToPokemon:
	.string "ARCHIE: KYOGRE dan GROUDON dua-dua\n"
	.string "terbang entah ke mana.\p"
	.string "Cuaca di HOENN dah kembali seperti\n"
	.string "biasa…\p"
	.string "Haha…\n"
	.string "Hahaha…\p"
	.string "Mungkin apa yang kami cuba buat\n"
	.string "cuma perkara kecil, malah tak\l"
	.string "bermakna, bagi POKéMON…$"

SootopolisCity_Text_InvolvedWithCrisisComeWithMe:
	.string "STEVEN: POKéMON yang bertarung\n"
	.string "itu… GROUDON… Dan KYOGRE…\p"
	.string "Dua POKéMON teramat purba itu\n"
	.string "terjaga dari tidur yang panjang…\p"
	.string "Dan sekarang mereka berlaga\n"
	.string "dengan tenaga yang tak terkawal…\p"
	.string "…{PLAYER}{KUN}.\p"
	.string "Kamu ada di sini, jadi saya\n"
	.string "anggap kamu dah bersedia\l"
	.string "untuk terlibat dalam krisis ini.\p"
	.string "Kalau begitu, ada seseorang\n"
	.string "yang saya nak kamu jumpa.\p"
	.string "Ikut saya, ya.$"

SootopolisCity_Text_DoesThisMakeYourFearPokemon:
	.string "STEVEN: Dengar sini, {PLAYER}{KUN}.\p"
	.string "Bila nampak GROUDON dan KYOGRE, kamu\n"
	.string "rasa POKéMON ni patut ditakuti ke?\p"
	.string "Tapi itu tak benar.\n"
	.string "POKéMON sebenarnya lebih…\p"
	.string "…Kenapa saya tanya kamu\n"
	.string "soalan ni? Kamu pun dah tahu.$"

SootopolisCity_Text_HereWereAreHelpWallace:
	.string "STEVEN: Okey, kita dah sampai!\p"
	.string "Di dalam sini ada seseorang\n"
	.string "bernama WALLACE.\p"
	.string "Saya rasa kamu mampu bantu dia…$"

SootopolisCity_Text_KnowWhatsNeededToHelpHim:
	.string "STEVEN: Saya rasa\n"
	.string "kamu mampu bantu dia…$"

SootopolisCity_Text_NeverBeenToSkyPillar:
	.string "STEVEN: TIANG LANGIT…\p"
	.string "Saya tak pernah ke sana.\n"
	.string "Di mana agaknya tempat itu?$"

SootopolisCity_Text_SoThatsRayquaza:
	.string "STEVEN: Jadi itulah RAYQUAZA…\p"
	.string "Luar biasa, dua POKéMON yang mengamuk\n"
	.string "itu lari ketakutan daripadanya…$"

SootopolisCity_Text_MaxieArchieLeft:
	.string "STEVEN: Nampaknya MAXIE dan ARCHIE\n"
	.string "dah pergi entah ke mana.\p"
	.string "Mungkin mereka ke GUNUNG PYRE untuk\n"
	.string "pulangkan MESTIKA itu…$"

SootopolisCity_Text_HaventYouScaledSkyPillar:
	.string "WALLACE: Oh?\n"
	.string "{PLAYER}{KUN}?\p"
	.string "Kamu belum panjat TIANG LANGIT lagi?\p"
	.string "Saya pasti kamu boleh sampai ke puncak\n"
	.string "TIANG LANGIT…$"

SootopolisCity_Text_AquaMagmaDidntMeanHarm:
	.string "WALLACE: {PLAYER}{KUN}…\p"
	.string "Ketua TEAM MAGMA dan AQUA, saya rasa\n"
	.string "mereka tak berniat jahat.\p"
	.string "Tak salah kalau kita dengar apa yang\n"
	.string "mereka nak katakan.$"

SootopolisCity_Text_ThankYouForHelpAcceptThis:
	.string "WALLACE: {PLAYER}{KUN}…\n"
	.string "Mata saya tak menipu.\p"
	.string "Berkat bantuan kamu, SOOTOPOLIS…\n"
	.string "Tidak, seluruh HOENN terselamat.\p"
	.string "Bagi pihak semua orang, saya ucapkan\n"
	.string "terima kasih.\p"
	.string "Ini hadiah daripada saya.\n"
	.string "Terimalah.$"

SootopolisCity_Text_ExplainWaterfallGoToGym:
	.string "HM itu mengandungi AIR TERJUN.\p"
	.string "Kalau kamu ada LENCANA HUJAN, POKéMON\n"
	.string "yang belajar move HM itu boleh\l"
	.string "mendaki air terjun.\p"
	.string "Dan di mana nak dapat LENCANA HUJAN?\n"
	.string "Kamu tahu, kan?\p"
	.string "Betul! Kamu kena kalahkan KETUA GIM\n"
	.string "SOOTOPOLIS.\p"
	.string "Bila dah bersedia, masuklah melalui\n"
	.string "pintu itu.$"

SootopolisCity_Text_DazzledByMentor:
	.string "WALLACE: Saya pasti kamu terpesona\n"
	.string "dengan gaya bertarung guru saya yang\l"
	.string "sangat anggun.$"
